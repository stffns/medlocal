# MedLocal environment variables (copy to .env and fill in)

# Gemini API key for teacher LLM (card generation, consultation index)
# Referenced by medlocal.toml as api_key = "env:GEMINI_API_KEY"
GEMINI_API_KEY=

# Optional: override the on-device LLM key (e.g. for a hosted OpenAI-compatible endpoint)
# MEDLOCAL_API_KEY=
