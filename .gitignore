__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
*.db
medlocal.toml
medlocal.*.toml
.env

# Source PDFs — large, copyrighted, rebuilt locally from SOURCES.md.
# The structured markdown in data/core/protocols/ is the committed truth.
data/core/hesperian/
data/core/msf/
data/core/who/

# Stray SQLite file created when a caller passes the literal string
# ":memory:" as a path instead of using SQLite's in-memory mode. Safety
# net so it cannot be committed even if it reappears.
:memory:

# Benchmark result artefacts — regenerated on every run, partial writes
# mid-bench should never be committed. The final summary printed to
# stdout is the canonical record; the JSON is for local inspection.
tests/comprehensive_results.json
tests/baseline_results_*.json

# Local agent configuration — tool-specific config files that belong
# to the author's development environment, not to the published
# codebase. AI-assistance disclosure lives in the Acknowledgments
# section of README.md and docs/HACKATHON-WRITEUP.md.
CLAUDE.md
.claude/
